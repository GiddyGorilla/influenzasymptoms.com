---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Influenza Symptoms — Complete Guide to Flu Signs & Warning Signals"
  description="Evidence-based guide to influenza symptoms. Learn the early signs, day-by-day progression, when to seek emergency care, and how flu differs from colds and COVID-19."
>
  <!-- Hero -->
  <section class="section-gradient-navy relative overflow-hidden text-white">
    <!-- Hero glow effects -->
    <div class="hero-glow hero-glow-teal"></div>
    <div class="hero-glow hero-glow-navy"></div>

    <!-- Hero illustration -->
    <div class="absolute right-0 top-1/2 -translate-y-1/2 w-[45%] hidden lg:block pointer-events-none opacity-40">
      <img src="/images/virus.svg" alt="" class="w-full h-auto animate-float-slow" aria-hidden="true" />
    </div>

    <!-- Background pattern -->
    <div class="absolute inset-0 opacity-[0.03]">
      <div class="absolute inset-0 section-pattern-dots"></div>
    </div>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 md:py-32 relative z-10">
      <div class="max-w-3xl">
        <!-- Trust pill -->
        <div class="inline-flex items-center gap-3 mb-6">
          <span class="trust-pill text-white/90 bg-teal-600/30 border-teal-500/30">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
            </svg>
            Evidence-Based Health Information
          </span>
          <span class="trust-pill text-white/80 bg-navy-700/40 border-navy-600/30">
            🩺 Medically Reviewed
          </span>
        </div>

        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-6 tracking-tight">
          Understand Your <span class="text-teal-400">Flu Symptoms</span>.
          <br class="hidden sm:block" />Know When to Act.
        </h1>
        <p class="text-lg md:text-xl text-gray-300 leading-relaxed mb-10 max-w-2xl">
          A focused, trustworthy resource for influenza symptoms &mdash; from early warning signs
          to emergency red flags. Evidence-based, regularly reviewed, designed for clarity.
        </p>

        <!-- Stats row -->
        <div class="flex flex-wrap gap-6 mb-10">
          <div class="stat-badge animate-fade-in">
            <span class="stat-number">44</span>
            <span class="stat-label">Articles</span>
          </div>
          <div class="stat-badge animate-fade-in stagger-1">
            <span class="stat-number">100+</span>
            <span class="stat-label">Citations</span>
          </div>
          <div class="stat-badge animate-fade-in stagger-2">
            <span class="stat-number">5</span>
            <span class="stat-label">Topic Areas</span>
          </div>
        </div>

        <!-- Hero search bar -->
        <div class="relative mb-8 max-w-xl" id="hero-search-wrapper">
          <div class="hero-search-wrapper flex items-center gap-3 bg-white/15 backdrop-blur-sm border border-white/20 rounded-xl px-5 py-4 transition-all duration-300 focus-within:bg-white focus-within:border-teal-400">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-teal-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="hero-search"
              placeholder='Search "fever duration", "flu vs cold", "when to see a doctor"...'
              class="bg-transparent border-none outline-none text-white placeholder-white/60 text-base w-full"
              autocomplete="off"
              aria-label="Search influenza symptoms and guides"
            />
            <span class="text-xs text-white/50 bg-white/10 rounded-md px-2 py-1 flex-shrink-0 hidden sm:inline-block">
              ⌘K
            </span>
          </div>
          <div id="hero-search-results" class="absolute top-full mt-3 left-0 right-0 max-h-80 overflow-y-auto bg-white rounded-xl shadow-2xl border border-gray-200 hidden z-50"></div>
        </div>

        <!-- Hero search script -->
        <script is:inline>
            const searchInput = document.getElementById('hero-search');
            const resultsDiv = document.getElementById('hero-search-results');
            let pf = null;
            let activeIdx = -1;
            let results = [];

            function getPagefind() {
              if (pf) return pf;
              if (typeof Pagefind === 'undefined') return null;
              try {
                pf = new Pagefind();
              } catch (e) {}
              return pf;
            }

            function hide() {
              resultsDiv.classList.add('hidden');
              activeIdx = -1;
              results = [];
            }

            function render(items) {
              if (!items?.length) {
                resultsDiv.innerHTML = '<div class="p-4 text-sm text-gray-500 text-center">No results found. Try a different search.</div>';
                resultsDiv.classList.remove('hidden');
                return;
              }
              results = items;
              activeIdx = -1;
              resultsDiv.innerHTML = items.map((r, i) => `
                <a href="${r.url}" class="block px-4 py-3 hover:bg-teal-50 border-b border-gray-100 last:border-b-0 transition-colors">
                  <div class="text-sm font-semibold text-navy-800 mb-0.5">${r.meta?.title || r.url}</div>
                  <div class="text-xs text-gray-500 line-clamp-2">${r.excerpt || ''}</div>
                </a>
              `).join('');
              resultsDiv.classList.remove('hidden');
            }

            function highlight(i) {
              resultsDiv.querySelectorAll('a').forEach((a, j) => {
                a.classList.toggle('bg-teal-50', j === i);
              });
            }

            async function doSearch(q) {
              if (!q || q.trim().length < 2) { hide(); return; }
              const p = getPagefind();
              if (!p) return;
              try {
                const sr = await p.search(q.trim());
                if (!sr) { hide(); return; }
                const items = await Promise.all(
                  sr.results.slice(0, 6).map(async (r) => {
                    const d = await r.data();
                    return { url: d.url, excerpt: d.excerpt, meta: d.meta };
                  })
                );
                render(items);
              } catch (e) { hide(); }
            }

            let timer;
            searchInput.addEventListener('input', (e) => {
              clearTimeout(timer);
              timer = setTimeout(() => doSearch(e.target.value), 200);
            });

            searchInput.addEventListener('keydown', (e) => {
              if (resultsDiv.classList.contains('hidden')) return;
              if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, results.length - 1); highlight(activeIdx); }
              else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); highlight(activeIdx); }
              else if (e.key === 'Enter' && activeIdx >= 0) { e.preventDefault(); const a = resultsDiv.querySelectorAll('a'); if (a[activeIdx]) a[activeIdx].click(); }
              else if (e.key === 'Escape') { hide(); }
            });

            document.addEventListener('click', (e) => {
              const w = document.getElementById('hero-search-wrapper');
              if (w && !w.contains(e.target)) hide();
            });

            searchInput.addEventListener('focus', () => {
              if (searchInput.value.trim().length >= 2) doSearch(searchInput.value);
            });
        </script>

        <div class="flex flex-wrap gap-4">
          <a href="/symptoms/" class="btn-primary text-lg">
            Explore Symptoms
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a href="/when-to-seek-help/" class="btn-secondary text-lg">
            🚨 Emergency Signs
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick symptom cards -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-16 relative z-20">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/symptoms/" class="card-premium card-gradient-accent p-7 animate-fade-in-up">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center flex-shrink-0">
            <img src="/images/thermometer.svg" alt="" class="w-7 h-7" aria-hidden="true" />
          </div>
          <h3 class="font-bold text-lg text-navy-800">Common Symptoms</h3>
        </div>
        <p class="text-sm text-gray-500 leading-relaxed">
          Fever, cough, body aches, fatigue, and more. Learn the hallmark signs of influenza.
        </p>
      </a>
      <a href="/compare/" class="card-premium card-gradient-accent p-7 animate-fade-in-up stagger-1">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center flex-shrink-0">
            <img src="/images/lungs.svg" alt="" class="w-7 h-7" aria-hidden="true" />
          </div>
          <h3 class="font-bold text-lg text-navy-800">Flu vs. Cold vs. COVID</h3>
        </div>
        <p class="text-sm text-gray-500 leading-relaxed">
          Can't tell them apart? Our detailed comparison helps you spot the differences.
        </p>
      </a>
      <a href="/when-to-seek-help/" class="card-premium card-gradient-accent p-7 animate-fade-in-up stagger-2 border-red-100 hover:border-red-200">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center flex-shrink-0">
            <span class="text-2xl">🚨</span>
          </div>
          <h3 class="font-bold text-lg text-navy-800">Emergency Warning Signs</h3>
        </div>
        <p class="text-sm text-gray-500 leading-relaxed">
          Know when flu symptoms require immediate medical attention. Don't wait.
        </p>
      </a>
    </div>
  </section>

  <!-- Symptom timeline teaser -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="card-premium overflow-hidden">
      <div class="grid md:grid-cols-2">
        <div class="p-10 md:p-14">
          <span class="text-teal-600 font-semibold text-sm uppercase tracking-wider">Day by Day Guide</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-navy-900 mt-3 mb-5 tracking-tight">
            Flu Symptoms Timeline: What to Expect Each Day
          </h2>
          <p class="text-gray-600 leading-relaxed mb-8">
            From the first tickle in your throat to full recovery. Our day-by-day guide walks you through
            the typical progression of influenza symptoms &mdash; so you know what's normal and what's not.
          </p>
          <div class="flex flex-wrap gap-2 mb-8">
            <span class="bg-amber-100 text-amber-800 text-xs font-semibold px-3 py-1.5 rounded-full">Day 1-2: Onset</span>
            <span class="bg-red-100 text-red-800 text-xs font-semibold px-3 py-1.5 rounded-full">Day 3-4: Peak</span>
            <span class="bg-teal-100 text-teal-800 text-xs font-semibold px-3 py-1.5 rounded-full">Day 5-7: Recovery</span>
          </div>
          <a href="/symptoms/flu-symptoms-timeline/" class="btn-primary">
            Read the full timeline
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
        </div>
        <div class="bg-gradient-to-br from-teal-600 via-teal-600 to-navy-800 p-10 md:p-14 flex items-center justify-center relative overflow-hidden">
          <div class="absolute inset-0 opacity-10">
            <div class="section-pattern-dots absolute inset-0"></div>
          </div>
          <div class="text-white space-y-6 text-center relative z-10">
            <img src="/images/timeline.svg" alt="" class="w-full max-w-sm mx-auto opacity-90" aria-hidden="true" />
            <p class="text-lg font-serif italic text-teal-100">"Knowing what to expect reduces anxiety. Most flu cases follow a predictable pattern."</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Topic hubs grid -->
  <section class="bg-white py-24 section-pattern-dots">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-14">
        <span class="text-teal-600 font-semibold text-sm uppercase tracking-wider">Comprehensive Guides</span>
        <h2 class="text-3xl md:text-4xl font-extrabold text-navy-900 mt-3 mb-4 tracking-tight">
          Everything You Need to Know About the Flu
        </h2>
        <p class="text-gray-500 max-w-2xl mx-auto leading-relaxed">
          Explore our comprehensive guides covering every aspect of influenza symptoms, treatment, and prevention.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/symptoms/" class="card-premium card-gradient-accent p-7 animate-fade-in-up group">
          <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <img src="/images/thermometer.svg" alt="" class="w-6 h-6" aria-hidden="true" />
          </div>
          <h3 class="font-bold text-lg text-navy-800 group-hover:text-teal-600 transition-colors mb-2">Symptoms Hub</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Complete guide to all flu symptoms, from common to severe. Day-by-day timeline, symptoms by age group.</p>
          <span class="inline-flex items-center gap-1 mt-4 text-teal-600 font-semibold text-sm group-hover:gap-2 transition-all">
            Browse symptoms <span class="text-lg leading-none">→</span>
          </span>
        </a>

        <a href="/compare/" class="card-premium card-gradient-accent p-7 animate-fade-in-up stagger-1 group">
          <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <img src="/images/lungs.svg" alt="" class="w-6 h-6" aria-hidden="true" />
          </div>
          <h3 class="font-bold text-lg text-navy-800 group-hover:text-teal-600 transition-colors mb-2">Compare Illnesses</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Flu vs. cold, COVID-19, RSV, strep throat, allergies. Clear comparison charts and symptom checklists.</p>
          <span class="inline-flex items-center gap-1 mt-4 text-teal-600 font-semibold text-sm group-hover:gap-2 transition-all">
            Compare symptoms <span class="text-lg leading-none">→</span>
          </span>
        </a>

        <a href="/when-to-seek-help/" class="card-premium card-gradient-accent p-7 animate-fade-in-up stagger-2 group">
          <div class="w-12 h-12 rounded-xl bg-red-100 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <span class="text-xl">🚨</span>
          </div>
          <h3 class="font-bold text-lg text-navy-800 group-hover:text-red-600 transition-colors mb-2">When to Seek Help</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Emergency warning signs, when to see a doctor, when to go to the ER, and telehealth options.</p>
          <span class="inline-flex items-center gap-1 mt-4 text-red-600 font-semibold text-sm group-hover:gap-2 transition-all">
            Know the signs <span class="text-lg leading-none">→</span>
          </span>
        </a>

        <a href="/treatment/" class="card-premium card-gradient-accent p-7 animate-fade-in-up stagger-3 group">
          <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <span class="text-xl">💊</span>
          </div>
          <h3 class="font-bold text-lg text-navy-800 group-hover:text-teal-600 transition-colors mb-2">Treatment & Recovery</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Medications, home remedies, recovery timeline, when antivirals help, and post-flu care.</p>
          <span class="inline-flex items-center gap-1 mt-4 text-teal-600 font-semibold text-sm group-hover:gap-2 transition-all">
            View treatments <span class="text-lg leading-none">→</span>
          </span>
        </a>

        <a href="/prevention/" class="card-premium card-gradient-accent p-7 animate-fade-in-up stagger-4 group">
          <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <img src="/images/shield.svg" alt="" class="w-6 h-6" aria-hidden="true" />
          </div>
          <h3 class="font-bold text-lg text-navy-800 group-hover:text-teal-600 transition-colors mb-2">Prevention Guide</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Vaccine information, hygiene habits, immune support, and how to protect your family during flu season.</p>
          <span class="inline-flex items-center gap-1 mt-4 text-teal-600 font-semibold text-sm group-hover:gap-2 transition-all">
            Prevent the flu <span class="text-lg leading-none">→</span>
          </span>
        </a>

        <a href="/symptoms/flu-symptoms-in-children/" class="card-premium card-gradient-accent p-7 animate-fade-in-up stagger-5 group">
          <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center mb-5 group-hover:scale-110 transition-transform duration-300">
            <span class="text-xl">👶</span>
          </div>
          <h3 class="font-bold text-lg text-navy-800 group-hover:text-teal-600 transition-colors mb-2">Flu in Children</h3>
          <p class="text-sm text-gray-500 leading-relaxed">Special considerations for babies, toddlers, and children. Warning signs every parent should know.</p>
          <span class="inline-flex items-center gap-1 mt-4 text-teal-600 font-semibold text-sm group-hover:gap-2 transition-all">
            Protect your child <span class="text-lg leading-none">→</span>
          </span>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
    <div class="text-center max-w-3xl mx-auto">
      <span class="text-teal-600 font-semibold text-sm uppercase tracking-wider">Our Commitment</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-navy-900 mt-3 mb-5 tracking-tight">
        Evidence-Based. Medically Reviewed. Transparent.
      </h2>
      <p class="text-gray-600 leading-relaxed mb-12">
        Every article is researched using authoritative sources &mdash; CDC, WHO, NHS, and peer-reviewed medical literature.
        We cite our sources, date-stamp our reviews, and maintain full editorial transparency.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="card-premium p-6 animate-fade-in-up">
          <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">📚</span>
          </div>
          <h4 class="font-bold text-navy-800 mb-1.5">Cited Sources</h4>
          <p class="text-sm text-gray-500 leading-relaxed">Every claim is backed by links to CDC, WHO, NHS, and peer-reviewed research.</p>
        </div>
        <div class="card-premium p-6 animate-fade-in-up stagger-1">
          <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">🩺</span>
          </div>
          <h4 class="font-bold text-navy-800 mb-1.5">Medical Review</h4>
          <p class="text-sm text-gray-500 leading-relaxed">Content is reviewed for accuracy. Last-reviewed dates on every page.</p>
        </div>
        <div class="card-premium p-6 animate-fade-in-up stagger-2">
          <div class="w-12 h-12 rounded-xl bg-teal-100 flex items-center justify-center mx-auto mb-4">
            <span class="text-2xl">🔓</span>
          </div>
          <h4 class="font-bold text-navy-800 mb-1.5">No Hidden Agenda</h4>
          <p class="text-sm text-gray-500 leading-relaxed">No ads, no sponsored content. Just clear, trustworthy health information.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
