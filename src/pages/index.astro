---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Influenza Symptoms — Complete Guide to Flu Signs & Warning Signals"
  description="Evidence-based guide to influenza symptoms. Learn the early signs, day-by-day progression, when to seek emergency care, and how flu differs from colds and COVID-19."
>
  <!-- Hero -->
  <section class="bg-gradient-to-br from-navy-900 via-navy-800 to-navy-700 text-white relative overflow-hidden">
    <!-- Subtle background illustration -->
    <svg class="absolute right-0 top-0 w-96 h-full opacity-5 pointer-events-none" viewBox="0 0 400 600" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="200" cy="150" r="80" fill="none" stroke="white" stroke-width="1"/>
      <circle cx="200" cy="150" r="60" fill="none" stroke="white" stroke-width="0.5"/>
      <circle cx="200" cy="150" r="8" fill="white"/>
      <line x1="200" y1="70" x2="200" y2="50" stroke="white" stroke-width="1"/>
      <line x1="200" y1="230" x2="200" y2="250" stroke="white" stroke-width="1"/>
      <line x1="120" y1="150" x2="100" y2="150" stroke="white" stroke-width="1"/>
      <line x1="280" y1="150" x2="300" y2="150" stroke="white" stroke-width="1"/>
      <line x1="143" y1="93" x2="129" y2="79" stroke="white" stroke-width="1"/>
      <line x1="257" y1="93" x2="271" y2="79" stroke="white" stroke-width="1"/>
      <line x1="143" y1="207" x2="129" y2="221" stroke="white" stroke-width="1"/>
      <line x1="257" y1="207" x2="271" y2="221" stroke="white" stroke-width="1"/>
      <!-- Stethoscope -->
      <path d="M 50 300 Q 50 250 100 250 Q 150 250 150 300 L 150 400" fill="none" stroke="white" stroke-width="2"/>
      <circle cx="150" cy="415" r="20" fill="none" stroke="white" stroke-width="2"/>
    </svg>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 md:py-28">
      <div class="max-w-3xl">
        <span class="inline-block bg-teal-600/30 text-teal-300 text-sm font-semibold px-4 py-1.5 rounded-full mb-6">
          🦠 Evidence-Based Health Information
        </span>
        <h1 class="text-4xl md:text-6xl font-extrabold leading-tight mb-6">
          Understand Your <span class="text-teal-400">Flu Symptoms</span>.
          Know When to Act.
        </h1>
        <p class="text-lg md:text-xl text-gray-300 leading-relaxed mb-8 max-w-2xl">
          A focused, trustworthy resource for influenza symptoms — from early warning signs to emergency red flags.
          Evidence-based, regularly reviewed, designed for clarity.
        </p>

        <!-- Hero search bar -->
        <div class="relative mb-8 max-w-xl" id="hero-search-wrapper">
          <div class="flex items-center gap-3 bg-white/15 backdrop-blur-sm border border-white/20 rounded-xl px-5 py-4 transition-all focus-within:bg-white focus-within:border-teal-400 focus-within:shadow-lg focus-within:shadow-teal-500/20">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-teal-300 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="hero-search"
              placeholder='Search "fever duration", "flu vs cold", "when to see a doctor"...'
              class="bg-transparent border-none outline-none text-white placeholder-white/60 text-base w-full"
              autocomplete="off"
              aria-label="Search influenza symptoms and guides"
            />
            <span class="text-xs text-white/50 bg-white/10 rounded-md px-2 py-1 flex-shrink-0 hidden sm:inline-block">
              ⌘K
            </span>
          </div>
          <div id="hero-search-results" class="absolute top-full mt-3 left-0 right-0 max-h-80 overflow-y-auto bg-white rounded-xl shadow-xl border border-gray-200 hidden z-50"></div>
        </div>

        <!-- Hero search script -->
        <script is:inline>
            const searchInput = document.getElementById('hero-search');
            const resultsDiv = document.getElementById('hero-search-results');
            let pf = null;
            let activeIdx = -1;
            let results = [];

            function getPagefind() {
              if (pf) return pf;
              if (typeof Pagefind === 'undefined') return null;
              try {
                pf = new Pagefind();
              } catch (e) {}
              return pf;
            }

            function hide() {
              resultsDiv.classList.add('hidden');
              activeIdx = -1;
              results = [];
            }

            function render(items) {
              if (!items?.length) {
                resultsDiv.innerHTML = '<div class="p-4 text-sm text-gray-500 text-center">No results found. Try a different search.</div>';
                resultsDiv.classList.remove('hidden');
                return;
              }
              results = items;
              activeIdx = -1;
              resultsDiv.innerHTML = items.map((r, i) => `
                <a href="${r.url}" class="block px-4 py-3 hover:bg-teal-50 border-b border-gray-100 last:border-b-0 transition-colors">
                  <div class="text-sm font-semibold text-navy-800 mb-0.5">${r.meta?.title || r.url}</div>
                  <div class="text-xs text-gray-500 line-clamp-2">${r.excerpt || ''}</div>
                </a>
              `).join('');
              resultsDiv.classList.remove('hidden');
            }

            function highlight(i) {
              resultsDiv.querySelectorAll('a').forEach((a, j) => {
                a.classList.toggle('bg-teal-50', j === i);
              });
            }

            async function doSearch(q) {
              if (!q || q.trim().length < 2) { hide(); return; }
              const p = getPagefind();
              if (!p) return;
              try {
                const sr = await p.search(q.trim());
                if (!sr) { hide(); return; }
                const items = await Promise.all(
                  sr.results.slice(0, 6).map(async (r) => {
                    const d = await r.data();
                    return { url: d.url, excerpt: d.excerpt, meta: d.meta };
                  })
                );
                render(items);
              } catch (e) { hide(); }
            }

            let timer;
            searchInput.addEventListener('input', (e) => {
              clearTimeout(timer);
              timer = setTimeout(() => doSearch(e.target.value), 200);
            });

            searchInput.addEventListener('keydown', (e) => {
              if (resultsDiv.classList.contains('hidden')) return;
              if (e.key === 'ArrowDown') { e.preventDefault(); activeIdx = Math.min(activeIdx + 1, results.length - 1); highlight(activeIdx); }
              else if (e.key === 'ArrowUp') { e.preventDefault(); activeIdx = Math.max(activeIdx - 1, 0); highlight(activeIdx); }
              else if (e.key === 'Enter' && activeIdx >= 0) { e.preventDefault(); const a = resultsDiv.querySelectorAll('a'); if (a[activeIdx]) a[activeIdx].click(); }
              else if (e.key === 'Escape') { hide(); }
            });

            document.addEventListener('click', (e) => {
              const w = document.getElementById('hero-search-wrapper');
              if (w && !w.contains(e.target)) hide();
            });

            searchInput.addEventListener('focus', () => {
              if (searchInput.value.trim().length >= 2) doSearch(searchInput.value);
            });
        </script>
        <div class="flex flex-wrap gap-4">
          <a href="/symptoms/" class="inline-flex items-center gap-2 bg-teal-600 hover:bg-teal-500 text-white font-semibold px-6 py-3 rounded-lg transition-colors text-lg">
            Explore Symptoms
            <span class="text-xl">→</span>
          </a>
          <a href="/when-to-seek-help/" class="inline-flex items-center gap-2 bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-3 rounded-lg transition-colors text-lg border border-white/20">
            🚨 Emergency Signs
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick symptom cards -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-12 relative z-10">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <a href="/symptoms/" class="group bg-white rounded-xl shadow-lg hover:shadow-xl transition-all p-6 border border-gray-100 hover:border-teal-200">
        <div class="text-3xl mb-3">🤒</div>
        <h3 class="font-bold text-lg text-navy-800 group-hover:text-teal-600 transition-colors mb-2">
          Common Symptoms
        </h3>
        <p class="text-sm text-gray-500">
          Fever, cough, body aches, fatigue, and more. Learn the hallmark signs of influenza.
        </p>
      </a>
      <a href="/compare/" class="group bg-white rounded-xl shadow-lg hover:shadow-xl transition-all p-6 border border-gray-100 hover:border-teal-200">
        <div class="text-3xl mb-3">🔬</div>
        <h3 class="font-bold text-lg text-navy-800 group-hover:text-teal-600 transition-colors mb-2">
          Flu vs. Cold vs. COVID
        </h3>
        <p class="text-sm text-gray-500">
          Can't tell them apart? Our detailed comparison helps you spot the differences.
        </p>
      </a>
      <a href="/when-to-seek-help/" class="group bg-white rounded-xl shadow-lg hover:shadow-xl transition-all p-6 border border-gray-100 hover:border-red-200">
        <div class="text-3xl mb-3">🚨</div>
        <h3 class="font-bold text-lg text-navy-800 group-hover:text-red-600 transition-colors mb-2">
          Emergency Warning Signs
        </h3>
        <p class="text-sm text-gray-500">
          Know when flu symptoms require immediate medical attention. Don't wait.
        </p>
      </a>
    </div>
  </section>

  <!-- Symptom timeline teaser -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="bg-white rounded-2xl shadow-lg border border-gray-100 overflow-hidden">
      <div class="grid md:grid-cols-2">
        <div class="p-8 md:p-12">
          <span class="text-teal-600 font-semibold text-sm uppercase tracking-wide">Day by Day Guide</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-navy-900 mt-2 mb-4">
            Flu Symptoms Timeline: What to Expect Each Day
          </h2>
          <p class="text-gray-600 leading-relaxed mb-6">
            From the first tickle in your throat to full recovery. Our day-by-day guide walks you through
            the typical progression of influenza symptoms — so you know what's normal and what's not.
          </p>
          <div class="flex flex-wrap gap-2 mb-6">
            <span class="bg-amber-100 text-amber-800 text-xs font-semibold px-3 py-1 rounded-full">Day 1-2: Onset</span>
            <span class="bg-red-100 text-red-800 text-xs font-semibold px-3 py-1 rounded-full">Day 3-4: Peak</span>
            <span class="bg-teal-100 text-teal-800 text-xs font-semibold px-3 py-1 rounded-full">Day 5-7: Recovery</span>
          </div>
          <a href="/symptoms/flu-symptoms-timeline/" class="inline-flex items-center gap-2 text-teal-600 font-semibold hover:text-teal-500 transition-colors">
            Read the full timeline →
          </a>
        </div>
        <div class="bg-gradient-to-br from-teal-600 to-navy-800 p-8 md:p-12 flex items-center justify-center">
          <div class="text-white space-y-6 text-center">
            <div class="text-5xl">📅</div>
            <p class="text-xl font-serif italic">"Knowing what to expect reduces anxiety. Most flu cases follow a predictable pattern."</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Topic hubs grid -->
  <section class="bg-white py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h2 class="text-3xl md:text-4xl font-extrabold text-navy-900 text-center mb-4">
        Everything You Need to Know About the Flu
      </h2>
      <p class="text-gray-500 text-center max-w-2xl mx-auto mb-12">
        Explore our comprehensive guides covering every aspect of influenza symptoms, treatment, and prevention.
      </p>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <a href="/symptoms/" class="group bg-cream rounded-xl p-6 border border-gray-100 hover:border-teal-300 hover:bg-teal-100/30 transition-all">
          <span class="text-3xl block mb-4">🦠</span>
          <h3 class="font-bold text-lg text-navy-800 group-hover:text-teal-600 transition-colors mb-2">Symptoms Hub</h3>
          <p class="text-sm text-gray-500">Complete guide to all flu symptoms, from common to severe. Day-by-day timeline, symptoms by age group.</p>
          <span class="inline-block mt-3 text-teal-600 font-semibold text-sm group-hover:translate-x-1 transition-transform">Browse symptoms →</span>
        </a>

        <a href="/compare/" class="group bg-cream rounded-xl p-6 border border-gray-100 hover:border-teal-300 hover:bg-teal-100/30 transition-all">
          <span class="text-3xl block mb-4">🔬</span>
          <h3 class="font-bold text-lg text-navy-800 group-hover:text-teal-600 transition-colors mb-2">Compare Illnesses</h3>
          <p class="text-sm text-gray-500">Flu vs. cold, COVID-19, RSV, strep throat, allergies. Clear comparison charts and symptom checklists.</p>
          <span class="inline-block mt-3 text-teal-600 font-semibold text-sm group-hover:translate-x-1 transition-transform">Compare symptoms →</span>
        </a>

        <a href="/when-to-seek-help/" class="group bg-cream rounded-xl p-6 border border-gray-100 hover:border-teal-300 hover:bg-teal-100/30 transition-all">
          <span class="text-3xl block mb-4">🚨</span>
          <h3 class="font-bold text-lg text-navy-800 group-hover:text-teal-600 transition-colors mb-2">When to Seek Help</h3>
          <p class="text-sm text-gray-500">Emergency warning signs, when to see a doctor, when to go to the ER, and telehealth options.</p>
          <span class="inline-block mt-3 text-teal-600 font-semibold text-sm group-hover:translate-x-1 transition-transform">Know the signs →</span>
        </a>

        <a href="/treatment/" class="group bg-cream rounded-xl p-6 border border-gray-100 hover:border-teal-300 hover:bg-teal-100/30 transition-all">
          <span class="text-3xl block mb-4">💊</span>
          <h3 class="font-bold text-lg text-navy-800 group-hover:text-teal-600 transition-colors mb-2">Treatment & Recovery</h3>
          <p class="text-sm text-gray-500">Medications, home remedies, recovery timeline, when antivirals help, and post-flu care.</p>
          <span class="inline-block mt-3 text-teal-600 font-semibold text-sm group-hover:translate-x-1 transition-transform">View treatments →</span>
        </a>

        <a href="/prevention/" class="group bg-cream rounded-xl p-6 border border-gray-100 hover:border-teal-300 hover:bg-teal-100/30 transition-all">
          <span class="text-3xl block mb-4">🛡️</span>
          <h3 class="font-bold text-lg text-navy-800 group-hover:text-teal-600 transition-colors mb-2">Prevention Guide</h3>
          <p class="text-sm text-gray-500">Vaccine information, hygiene habits, immune support, and how to protect your family during flu season.</p>
          <span class="inline-block mt-3 text-teal-600 font-semibold text-sm group-hover:translate-x-1 transition-transform">Prevent the flu →</span>
        </a>

        <a href="/symptoms/flu-symptoms-in-children/" class="group bg-cream rounded-xl p-6 border border-gray-100 hover:border-teal-300 hover:bg-teal-100/30 transition-all">
          <span class="text-3xl block mb-4">👶</span>
          <h3 class="font-bold text-lg text-navy-800 group-hover:text-teal-600 transition-colors mb-2">Flu in Children</h3>
          <p class="text-sm text-gray-500">Special considerations for babies, toddlers, and children. Warning signs every parent should know.</p>
          <span class="inline-block mt-3 text-teal-600 font-semibold text-sm group-hover:translate-x-1 transition-transform">Protect your child →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Trust section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
    <div class="text-center max-w-3xl mx-auto">
      <span class="text-teal-600 font-semibold text-sm uppercase tracking-wide">Our Commitment</span>
      <h2 class="text-3xl md:text-4xl font-extrabold text-navy-900 mt-2 mb-4">
        Evidence-Based. Medically Reviewed. Transparent.
      </h2>
      <p class="text-gray-600 leading-relaxed mb-10">
        Every article is researched using authoritative sources — CDC, WHO, NHS, and peer-reviewed medical literature.
        We cite our sources, date-stamp our reviews, and maintain full editorial transparency.
      </p>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        <div class="bg-white rounded-xl p-6 border border-gray-100">
          <div class="text-3xl mb-3">📚</div>
          <h4 class="font-bold text-navy-800 mb-1">Cited Sources</h4>
          <p class="text-sm text-gray-500">Every claim is backed by links to CDC, WHO, NHS, and peer-reviewed research.</p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-gray-100">
          <div class="text-3xl mb-3">🩺</div>
          <h4 class="font-bold text-navy-800 mb-1">Medical Review</h4>
          <p class="text-sm text-gray-500">Content is reviewed for accuracy. Last-reviewed dates on every page.</p>
        </div>
        <div class="bg-white rounded-xl p-6 border border-gray-100">
          <div class="text-3xl mb-3">🔓</div>
          <h4 class="font-bold text-navy-800 mb-1">No Hidden Agenda</h4>
          <p class="text-sm text-gray-500">No ads, no sponsored content. Just clear, trustworthy health information.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
