---
import "../styles/global.css";
export interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: Record<string, any>[];
}
const { title, description, image, jsonLd = [] } = Astro.props;
const fullTitle = `${title} | InfluenzaSymptoms.com`;
const siteUrl = Astro.site?.origin ?? "https://influenzasymptoms.com";
const currentUrl = new URL(Astro.url.pathname, siteUrl).href;

// --- Schema.org: Organization ---
const organizationSchema: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "InfluenzaSymptoms.com",
  url: siteUrl,
  sameAs: [],
};

// --- Schema.org: WebSite ---
const webSiteSchema: Record<string, any> = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "InfluenzaSymptoms.com",
  url: siteUrl,
  description:
    "Evidence-based medical information about influenza symptoms, treatment, and prevention.",
  potentialAction: {
    "@type": "SearchAction",
    target: {
      "@type": "EntryPoint",
      urlTemplate: `${siteUrl}/search?q={search_term_string}`,
    },
    "query-input": "required name=search_term_string",
  },
};

// --- BreadcrumbList (auto-generated from URL path for non-root pages) ---
function generateBreadcrumbs(pathname: string): Record<string, any> | null {
  if (pathname === "/" || pathname === "") return null;
  const segments = pathname.replace(/^\/|\/$/g, "").split("/");
  if (segments.length === 0 || segments[0] === "") return null;

  const items: Record<string, any>[] = [
    {
      "@type": "ListItem",
      position: 1,
      name: "Home",
      item: siteUrl,
    },
  ];

  let accumulatedPath = "";
  segments.forEach((seg, i) => {
    if (!seg) return;
    accumulatedPath += "/" + seg;
    const name = seg
      .replace(/-/g, " ")
      .replace(/\b\w/g, (c) => c.toUpperCase());
    items.push({
      "@type": "ListItem",
      position: i + 2,
      name,
      item: `${siteUrl}${accumulatedPath}/`,
    });
  });

  return {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: items,
  };
}

const breadcrumbSchema = generateBreadcrumbs(Astro.url.pathname);

// Build combined JSON-LD array
const allSchemas: Record<string, any>[] = [
  organizationSchema,
  webSiteSchema,
];
if (breadcrumbSchema) allSchemas.push(breadcrumbSchema);
if (jsonLd.length > 0) allSchemas.push(...jsonLd);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Source+Serif+4:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
    <title>{fullTitle}</title>
    <!-- Schema.org JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(allSchemas.length === 1 ? allSchemas[0] : { "@context": "https://schema.org", "@graph": allSchemas.map(s => { const { "@context": _, ...rest } = s; return rest; }) })} />
  </head>
  <body>
    <!-- Emergency banner -->
    <div class="bg-red-600 text-white text-center py-2 px-4 text-sm font-medium">
      ⚠️ If you are experiencing a medical emergency, call 911 (US) or 112 (EU) immediately.
      This site provides educational information only — not medical advice.
    </div>

    <!-- Header -->
    <header class="bg-white border-b border-gray-100 sticky top-0 z-50">
      <nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href="/" class="flex items-center gap-2 font-bold text-xl text-navy-800 hover:text-teal-600 transition-colors">
            <span class="text-2xl">🦠</span>
            <span>Influenza<span class="text-teal-600">Symptoms</span></span>
          </a>
          <div class="hidden md:flex items-center gap-8">
            <a href="/symptoms/" class="text-sm font-medium text-gray-600 hover:text-navy-800 transition-colors">Symptoms</a>
            <a href="/compare/" class="text-sm font-medium text-gray-600 hover:text-navy-800 transition-colors">Compare</a>
            <a href="/when-to-seek-help/" class="text-sm font-medium text-gray-600 hover:text-navy-800 transition-colors">When to Seek Help</a>
            <a href="/treatment/" class="text-sm font-medium text-gray-600 hover:text-navy-800 transition-colors">Treatment</a>
            <a href="/prevention/" class="text-sm font-medium text-gray-600 hover:text-navy-800 transition-colors">Prevention</a>
          </div>

          <!-- Search -->
          <div class="relative" id="search-wrapper">
            <div class="flex items-center gap-2 bg-gray-100 rounded-lg px-3 py-2 transition-colors focus-within:bg-white focus-within:ring-2 focus-within:ring-teal-500 focus-within:shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-400 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
              <input
                type="text"
                id="search"
                placeholder="Search symptoms, treatments..."
                class="bg-transparent border-none outline-none text-sm text-gray-700 placeholder-gray-400 w-48 transition-all focus:w-64"
                autocomplete="off"
                aria-label="Search the site"
              />
            </div>
            <div id="search-results" class="absolute top-full mt-2 right-0 w-96 max-h-96 overflow-y-auto bg-white rounded-xl shadow-xl border border-gray-200 hidden z-50"></div>
          </div>
          <button id="mobile-menu-btn" class="md:hidden text-gray-600" aria-label="Menu">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>
        <!-- Mobile menu -->
        <div id="mobile-menu" class="hidden md:hidden border-t border-gray-100 pb-4">
          <a href="/symptoms/" class="block px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50">Symptoms</a>
          <a href="/compare/" class="block px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50">Compare</a>
          <a href="/when-to-seek-help/" class="block px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50">When to Seek Help</a>
          <a href="/treatment/" class="block px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50">Treatment</a>
          <a href="/prevention/" class="block px-4 py-2 text-sm font-medium text-gray-600 hover:bg-gray-50">Prevention</a>
        </div>
        <script>
          document.getElementById('mobile-menu-btn').addEventListener('click', function() {
            document.getElementById('mobile-menu').classList.toggle('hidden');
          });
        </script>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-navy-900 text-gray-300 mt-20">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div class="md:col-span-1">
            <a href="/" class="text-white font-bold text-lg mb-3 block">
              🦠 InfluenzaSymptoms
            </a>
            <p class="text-sm text-gray-400">
              Evidence-based information about influenza symptoms, treatment, and prevention.
            </p>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-3">Explore</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/symptoms/" class="hover:text-white transition-colors">Symptoms</a></li>
              <li><a href="/compare/" class="hover:text-white transition-colors">Compare Illnesses</a></li>
              <li><a href="/when-to-seek-help/" class="hover:text-white transition-colors">When to Seek Help</a></li>
              <li><a href="/treatment/" class="hover:text-white transition-colors">Treatment</a></li>
              <li><a href="/prevention/" class="hover:text-white transition-colors">Prevention</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-3">About</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/about/" class="hover:text-white transition-colors">About Us</a></li>
              <li><a href="/about/#editorial-policy" class="hover:text-white transition-colors">Editorial Policy</a></li>
              <li><a href="/about/#medical-review" class="hover:text-white transition-colors">Medical Review</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-white font-semibold mb-3">Legal</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/disclaimer/" class="hover:text-white transition-colors">Medical Disclaimer</a></li>
              <li><a href="/privacy/" class="hover:text-white transition-colors">Privacy Policy</a></li>
              <li><a href="/terms/" class="hover:text-white transition-colors">Terms of Use</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-700 mt-8 pt-8 text-sm text-gray-500 text-center">
          <p>© 2026 InfluenzaSymptoms.com. All content is for informational purposes only. Not a substitute for professional medical advice.</p>
        </div>
      </div>
    </footer>

    <!-- Pagefind search -->
    <script src="/pagefind/pagefind.js" defer></script>
    <script is:inline>
        const searchInput = document.getElementById('search');
        const resultsDiv = document.getElementById('search-results');
        let pagefindInstance = null;
        let activeIndex = -1;
        let currentResults = [];

        function getPagefind() {
          if (pagefindInstance) return pagefindInstance;
          if (typeof Pagefind === 'undefined') return null;
          try {
            pagefindInstance = new Pagefind();
          } catch (e) {
            console.warn('Pagefind init failed:', e.message);
          }
          return pagefindInstance;
        }

        function renderResults(results) {
          if (!results || results.length === 0) {
            resultsDiv.innerHTML = '<div class="p-4 text-sm text-gray-500 text-center">No results found.</div>';
            resultsDiv.classList.remove('hidden');
            return;
          }
          currentResults = results;
          activeIndex = -1;

          resultsDiv.innerHTML = results.map((result, idx) => {
            const meta = result.meta || {};
            return `
              <a href="${result.url}" class="block px-4 py-3 hover:bg-gray-50 border-b border-gray-100 last:border-b-0 transition-colors ${idx === 0 ? 'rounded-t-xl' : ''} ${idx === results.length - 1 ? 'rounded-b-xl' : ''}">
                <div class="text-sm font-semibold text-navy-800 mb-0.5">${result.meta?.title || result.url}</div>
                <div class="text-xs text-gray-500 line-clamp-2">${result.excerpt || ''}</div>
              </a>
            `;
          }).join('');

          resultsDiv.classList.remove('hidden');
        }

        function hideResults() {
          resultsDiv.classList.add('hidden');
          activeIndex = -1;
          currentResults = [];
        }

        function highlightResult(index) {
          const links = resultsDiv.querySelectorAll('a');
          links.forEach((link, i) => {
            if (i === index) {
              link.classList.add('bg-teal-50');
            } else {
              link.classList.remove('bg-teal-50');
            }
          });
        }

        async function search(query) {
          if (!query || query.trim().length < 2) {
            hideResults();
            return;
          }

          const pf = getPagefind();
          if (!pf) return;

          try {
            const searchResults = await pf.search(query.trim());
            if (!searchResults) {
              hideResults();
              return;
            }

            const processed = await Promise.all(
              searchResults.results.slice(0, 8).map(async (r) => {
                const data = await r.data();
                return {
                  url: data.url,
                  excerpt: data.excerpt,
                  meta: data.meta,
                  raw_url: data.raw_url,
                };
              })
            );

            renderResults(processed);
          } catch (e) {
            console.warn('Search failed:', e.message);
            hideResults();
          }
        }

        // Debounced input handler
        let debounceTimer;
        searchInput.addEventListener('input', (e) => {
          clearTimeout(debounceTimer);
          debounceTimer = setTimeout(() => search(e.target.value), 200);
        });

        // Keyboard navigation
        searchInput.addEventListener('keydown', (e) => {
          if (!resultsDiv.classList.contains('hidden')) {
            if (e.key === 'ArrowDown') {
              e.preventDefault();
              activeIndex = Math.min(activeIndex + 1, currentResults.length - 1);
              highlightResult(activeIndex);
            } else if (e.key === 'ArrowUp') {
              e.preventDefault();
              activeIndex = Math.max(activeIndex - 1, 0);
              highlightResult(activeIndex);
            } else if (e.key === 'Enter' && activeIndex >= 0) {
              e.preventDefault();
              const links = resultsDiv.querySelectorAll('a');
              if (links[activeIndex]) links[activeIndex].click();
            } else if (e.key === 'Escape') {
              hideResults();
            }
          }
        });

        // Click outside to close
        document.addEventListener('click', (e) => {
          const wrapper = document.getElementById('search-wrapper');
          if (wrapper && !wrapper.contains(e.target)) {
            hideResults();
          }
        });

        // Focus handler — reopen results if there's text
        searchInput.addEventListener('focus', () => {
          if (searchInput.value.trim().length >= 2) {
            search(searchInput.value);
          }
        });
    </script>
  </body>
</html>
